{
    "name": "fosseva/employeon-core",
    "description": "The minimal core for Employeon employee operations applications.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Employeon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Employeon\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^2.34|^3.0",
        "pestphp/pest-plugin-laravel": "^2.4|^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Employeon\\EmployeonServiceProvider"
            ],
            "aliases": {
                "Employeon": "Employeon\\Facades\\Employeon"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
